# Copy to .env and replace both password placeholders before starting Compose.
# APP_PORT is the published localhost port. The container always listens on 8090.
APP_PORT=8090
APP_TRUSTED_HOSTS=localhost,127.0.0.1,[::1],app

# Database bootstrap account and separate application login.
POSTGRES_DB=taskops
POSTGRES_ADMIN_USER=taskops_admin
POSTGRES_ADMIN_PASSWORD=
DB_USER=taskops
DB_PASSWORD=

# Compose service DNS and PostgreSQL's internal port.
# For native development, use the hostname and port of a dedicated local database.
DB_HOST=db
DB_PORT=5432
DB_SSLMODE=prefer

# Release metadata. These values can also be supplied as Docker build arguments.
APP_VERSION=0.1.0
GIT_COMMIT_SHA=
BUILD_DATE=

LOG_LEVEL=INFO
# 1 loads the synthetic sample tasks once per database. Set to 0 for an empty workspace.
SEED_DEMO=1
